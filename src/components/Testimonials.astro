---
import { load, LI, liSrc } from '../lib/data';
const testimonials = load('testimonials.yaml');
const items = testimonials.items || [];
---
<section id="testimonials" class="py-20 md:py-28 px-6 bg-surface scroll-mt-16">
  <div class="max-w-[1100px] mx-auto">
    {(testimonials.label || testimonials.heading) && (
      <div class="reveal">
        {testimonials.label && <p class="text-[14px] font-mono text-accent tracking-[0.12em] uppercase mb-3">{testimonials.label}</p>}
        {testimonials.heading && (
          <h2 class="font-display text-[32px] md:text-[44px] font-bold text-ink mb-10 tracking-[-0.01em]">
            {testimonials.heading}
          </h2>
        )}
      </div>
    )}

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {items.map((t: any, i: number) => (
        <div class={`reveal ${i % 2 === 1 ? 'delay-1' : ''} card-glow bg-surface-raised rounded-[16px] p-6 flex flex-col`}>
          {t.rating > 0 && (
            <div class="flex gap-0.5 mb-3" aria-label={`${t.rating}/5`}>
              {Array.from({ length: 5 }).map((_, s) => (
                <svg viewBox="0 0 20 20" class={`w-4 h-4 ${s < t.rating ? 'text-accent' : 'text-border'}`} fill="currentColor"><path d="M10 1.5l2.6 5.27 5.82.85-4.21 4.1 1 5.8L10 14.9l-5.21 2.74 1-5.8-4.21-4.1 5.82-.85z"/></svg>
              ))}
            </div>
          )}
          {t.quote && <p class="text-[16px] text-ink-secondary leading-[1.7] mt-0 mb-5 flex-1">&ldquo;{t.quote}&rdquo;</p>}
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-accent-wash flex items-center justify-center shrink-0 font-display font-bold text-accent text-[15px]">
              {(t.name || '?').charAt(0)}
            </div>
            <div class="min-w-0">
              {t.name && <p class="text-[14px] font-medium text-ink m-0 truncate">{t.name}</p>}
              {t.role && <p class="text-[13px] text-ink-tertiary m-0 truncate">{t.role}</p>}
            </div>
            {t.icon && <lord-icon src={liSrc(t.icon)} trigger="morph" colors={LI.dark} class="li-sm ml-auto shrink-0"></lord-icon>}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
